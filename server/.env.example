# Required. Generate with: openssl rand -hex 32
JWT_SECRET=

# Database. Prefer a least-privilege role (see server/scripts/create-app-role.sql)
# over the postgres superuser. DATABASE_URL, if set, overrides the DB_* values.
DB_USER=notes_app
DB_HOST=localhost
DB_NAME=notes_app
DB_PASSWORD=
DB_PORT=5432
# DATABASE_URL=postgres://notes_app:password@localhost:5432/notes_app

PORT=3004
# HOST=127.0.0.1          # listen only on loopback when a reverse proxy runs on this machine

# ── HTTPS ────────────────────────────────────────────────────────────────
# The app must be served over HTTPS (or http://localhost): browsers only
# expose the Web Crypto API in secure contexts. See docs/OPERATIONS.md.
# COOKIE_SECURE=true      # default; 'auto' follows req.secure, 'false' only for plain-HTTP development
# TRUST_PROXY=loopback    # set when behind a reverse proxy (hop count, 'loopback', or subnets)
# HSTS_MAX_AGE=15552000   # seconds; 0 disables
# CORS_ORIGINS=           # comma-separated; empty = same-origin only (recommended)

# ── Registration ─────────────────────────────────────────────────────────
# SIGNUP_MODE=open        # open | invite | closed
# SIGNUP_INVITE_CODE=     # required when SIGNUP_MODE=invite

# ── Storage ──────────────────────────────────────────────────────────────
# Relative paths are resolved against the server directory.
# STORAGE_ROOT=storage            # parent of the directories below
# STORAGE_DIR=storage/blobs       # encrypted attachments
# DELETED_BLOBS_DIR=storage/deleted
# LEGACY_UPLOADS_DIR=uploads      # pre-encryption files (read-only)
# LEGACY_QUARANTINE_DIR=storage/legacy-quarantine

# ── Limits and quotas ────────────────────────────────────────────────────
# MAX_BLOB_BYTES=26214400               # 25 MiB per attachment
# USER_STORAGE_QUOTA_BYTES=2147483648   # 2 GiB per account; 0 = unlimited
# MAX_NOTES_PER_USER=100000
# NOTE_MAX_BYTES=8388608                # encrypted size of one note
# MAX_REVISIONS_PER_NOTE=30

# ── Retention ────────────────────────────────────────────────────────────
# TRASH_RETENTION_DAYS=30
# BLOB_GC_GRACE_DAYS=30           # unreferenced attachments are kept this long
# DELETED_FILES_RETENTION_DAYS=7  # collected files stay recoverable this long
# LEGACY_QUARANTINE_DAYS=30
# REVISION_MAX_AGE_DAYS=365
# SNAPSHOT_INTERVAL_MINUTES=10
# SESSION_IDLE_DAYS=14
# SESSION_MAX_DAYS=90

# ── Abuse controls ───────────────────────────────────────────────────────
# RATE_LIMITS=true
# RATE_LIMIT_LOGIN_IP=30          # per 15 minutes
# RATE_LIMIT_LOGIN_ACCOUNT=20     # failed attempts per account per 15 minutes
# RATE_LIMIT_SIGNUP=10            # per IP per hour
# RATE_LIMIT_API_PER_MINUTE=1200

# ── Background jobs ──────────────────────────────────────────────────────
# BACKGROUND_JOBS=true
# MAINTENANCE_INTERVAL_MINUTES=60
